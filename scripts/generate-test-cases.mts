// ---------------------------------------------------------------- workbook
const HEADER_FILL: ExcelJS.Fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1F3A5F' } };
const BORDER: Partial<ExcelJS.Borders> = {
  top: { style: 'thin', color: { argb: 'FFD0D7DE' } },
  bottom: { style: 'thin', color: { argb: 'FFD0D7DE' } },
  left: { style: 'thin', color: { argb: 'FFD0D7DE' } },
  right: { style: 'thin', color: { argb: 'FFD0D7DE' } },
};

function styleSheet(sheet: ExcelJS.Worksheet) {
  const header = sheet.getRow(1);
  header.font = { bold: true, color: { argb: 'FFFFFFFF' } };
  header.fill = HEADER_FILL;
  header.alignment = { vertical: 'middle', wrapText: true };
  header.height = 22;
  sheet.views = [{ state: 'frozen', ySplit: 1 }];
  sheet.autoFilter = { from: { row: 1, column: 1 }, to: { row: 1, column: sheet.columnCount } };
  sheet.eachRow((row, i) => {
    row.eachCell((cell) => {
      cell.border = BORDER;
      if (i > 1) cell.alignment = { vertical: 'top', wrapText: true };
    });
  });
}

const workbook = new ExcelJS.Workbook();
workbook.creator = 'QA Automation';
workbook.created = new Date();

// Summary
const summary = workbook.addWorksheet('Summary');
summary.columns = [
  { header: 'Module', key: 'module', width: 14 },
  { header: 'Total', key: 'total', width: 8 },
  { header: 'Functional', key: 'Functional', width: 12 },
  { header: 'Negative', key: 'Negative', width: 11 },
  { header: 'Edge', key: 'Edge', width: 8 },
  { header: 'Security', key: 'Security', width: 10 },
  { header: 'UI/Usability', key: 'UI/Usability', width: 13 },
  { header: 'Automated', key: 'automated', width: 11 },
  { header: 'Manual', key: 'manual', width: 9 },
];
for (const module of ['Login', 'Cart', 'API']) {
  const inModule = cases.filter((c) => c.module === module);
  const row: Record<string, string | number> = { module, total: inModule.length };
  for (const type of ['Functional', 'Negative', 'Edge', 'Security', 'UI/Usability'])
    row[type] = inModule.filter((c) => c.type === type).length;
  row.automated = inModule.filter((c) => c.automation !== 'Manual').length;
  row.manual = inModule.filter((c) => c.automation === 'Manual').length;
  summary.addRow(row);
}
const totalRow = summary.addRow({ module: 'Total' });
for (let col = 2; col <= summary.columnCount; col++) {
  const letter = summary.getColumn(col).letter;
  totalRow.getCell(col).value = { formula: `SUM(${letter}2:${letter}${totalRow.number - 1})` };
}
totalRow.font = { bold: true };
styleSheet(summary);
summary.addRow([]);
summary.addRow(['Application: https://www.demoblaze.com (API: https://api.demoblaze.com)']);
summary.addRow([
  '"(expected to fail)" = automated check that documents a known defect; it turns red once the defect is fixed.',
]);

// One sheet per module
const columns: Partial<ExcelJS.Column>[] = [
  { header: 'ID', key: 'id', width: 14 },
  { header: 'Feature', key: 'feature', width: 18 },
  { header: 'Title', key: 'title', width: 36 },
  { header: 'Type', key: 'type', width: 12 },
  { header: 'Priority', key: 'priority', width: 9 },
  { header: 'Preconditions', key: 'preconditions', width: 30 },
  { header: 'Steps', key: 'steps', width: 46 },
  { header: 'Test data', key: 'data', width: 24 },
  { header: 'Expected result', key: 'expected', width: 46 },
  { header: 'Automation', key: 'automation', width: 34 },
  { header: 'Notes', key: 'notes', width: 36 },
];
const typeColors: Record<CaseType, string> = {
  Functional: 'FFE3F2FD',
  Negative: 'FFFDECEA',
  Edge: 'FFFFF4E5',
  Security: 'FFF3E5F5',
  'UI/Usability': 'FFE8F5E9',
};
for (const [sheetName, module] of [
  ['Login', 'Login'],
  ['Cart & Order', 'Cart'],
  ['API', 'API'],
] as const) {
  const sheet = workbook.addWorksheet(sheetName);
  sheet.columns = columns;
  for (const c of cases.filter((tc) => tc.module === module)) {
    const row = sheet.addRow({ ...c, steps: c.steps.map((s, i) => `${i + 1}. ${s}`).join('\n'), notes: c.notes ?? '' });
    row.getCell('type').fill = { type: 'pattern', pattern: 'solid', fgColor: { argb: typeColors[c.type] } };
  }
  styleSheet(sheet);
}

