# Copy to .env.demo and/or .env.prod. ENV (default demo) picks the file:
#   npm run test:demo  -> .env.demo      npm run test:prod -> .env.prod
# Every value except the credentials has a default, so it may be left out.
ENV=demo
BASE_URL=https://www.demoblaze.com
API_URL=https://api.demoblaze.com

# Pre-registered DemoBlaze account (sign up at https://www.demoblaze.com)
DEMO_USERNAME=
DEMO_PASSWORD=

# Runner
HEADLESS=true                # false shows the browser
WORKER=1                     # parallel workers: a count or a share of cores, e.g. 50%
BROWSERS=chromium            # engines for UI/E2E: chromium, firefox, webkit (comma separated)

# Timeouts (ms)
TEST_TIMEOUT_MS=60000        # whole test
EXPECT_TIMEOUT_MS=10000      # each expect() assertion
ACTION_TIMEOUT_MS=15000      # each click/fill/...
NAVIGATION_TIMEOUT_MS=30000  # each goto/reload

# Performance budgets
PERF_PAGE_LOAD_BUDGET_MS=8000
PERF_API_P95_BUDGET_MS=3000
PERF_API_SAMPLES=10
